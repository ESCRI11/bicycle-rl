{
  "_comment": "Sources for harvest.py. Deliberately excludes extension libraries (hyper-hydra, antlia, HY5): their functions do not exist in vanilla hydra-synth, and training on them teaches the model to hallucinate API — the exact failure we are trying to fix. p5 running inside hydra IS in scope: it is core hydra (the editor ships the P5 wrapper), and it is how sketches get geometry, text and typography that the GLSL chain cannot express.",
  "files": [
    {
      "url": "https://raw.githubusercontent.com/hydra-synth/hydra/main/src/stores/examples.json",
      "source": "https://github.com/hydra-synth/hydra/blob/main/src/stores/examples.json",
      "format": "editor-json",
      "origin": "hydra-editor-examples",
      "license": "CC BY-NC-SA 4.0"
    }
  ],
  "trees": [
    {
      "repo": "hydra-synth/hydra-examples",
      "branch": "master",
      "match": "\\.js$",
      "origin": "hydra-examples",
      "license": "unknown"
    },
    {
      "repo": "micuat/hydra-book",
      "branch": "master",
      "match": "\\.md$",
      "skip": "_sidebar|README",
      "origin": "hydra-book",
      "license": "hydra-book (Naoto Hieda)"
    },
    {
      "repo": "hydra-synth/hydra-docs-v2",
      "branch": "main",
      "match": "^content/docs/.*\\.md$",
      "origin": "hydra-docs",
      "license": "hydra docs (CC BY-NC-SA 4.0)"
    }
  ],
  "searches": [
    {
      "query": "\"out(o0)\" \"modulate(\" extension:js",
      "limit": 60
    },
    {
      "query": "\"kaleid(\" \"osc(\" extension:js",
      "limit": 60
    },
    {
      "query": "\"modulateScale\" \"noise(\" extension:js",
      "limit": 60
    },
    {
      "query": "\"voronoi(\" \"out(o0)\" extension:js",
      "limit": 40
    },
    {
      "query": "\"src(o0)\" \"blend(\" extension:js",
      "limit": 40
    },
    {
      "query": "\"colorama(\" extension:js",
      "limit": 40
    },
    {
      "query": "\"repeatX(\" \"scrollY(\" extension:js",
      "limit": 40
    },
    {
      "query": "hydra \"out(o0)\" extension:md",
      "limit": 60
    },
    {
      "query": "\"osc(\" \"kaleid(\" extension:md",
      "limit": 40
    },
    {
      "query": "\"modulatePixelate\" extension:js",
      "limit": 40
    },
    {
      "query": "\"new P5(\" \"s0.init\" extension:js",
      "limit": 60
    },
    {
      "query": "\"p5.canvas\" \"src(s0)\" extension:js",
      "limit": 60
    },
    {
      "query": "\"new P5(\" hydra extension:md",
      "limit": 40
    }
  ]
}
